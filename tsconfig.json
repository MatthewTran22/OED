{
	"compilerOptions": {
		"baseUrl": "./src/client/app/",
		"outDir": "./src/client/public/app/",
		"sourceMap": true,
		"module": "ESNext",
		"target": "ES2020",
		"jsx": "react-jsx",
		"allowJs": true,
		"lib": [
			"ES2020",
			"DOM",
			"DOM.Iterable"
		],
		"moduleResolution": "bundler",
		"rootDir": "src",
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"noImplicitReturns": true,
		"noImplicitThis": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"noUnusedLocals": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"skipLibCheck": true
	},
	"include": [
		"./src/client/app/**/*",
		"./vite.config.ts"
	],
	"exclude": [
		"node_modules"
	]
}
